# ---------------------------------------------------------------------
# ulogin public/.htaccess          (감사 M-4 / 문서라운드 F-6 / v1.2.0 캐시 D-85·D-86)
#
# 이 디렉토리에는 사람이 브라우저로 여는 화면만 있다.
#   index / login / register / forgot / reset / verify / mypage / admin  (8개)
#   assets/{style.css, api.js, ui.js, ulogin-client.js}
#   version.txt   — 지금 서버에 올라간 버전 문자열 한 줄 (배포 반영 확인용)
# server/.htaccess 의 헤더는 server/ 하위에만 상속되므로 화면 쪽에는
# 지금까지 어떤 보안 헤더도 붙지 않았다. 이 파일이 그 한 겹을 채운다.
#
# ▣ 한계 — 이 파일은 방어의 전부가 아니다 (리더 판정 D-34 / 감사 H-5 와 같은 원칙)
#   - nginx · LiteSpeed 비호환 모드 · `AllowOverride None` 환경에서는
#     이 파일이 **통째로 무시된다.** 그런 환경에서는 서버 설정(nginx `add_header`,
#     Apache `<Directory>`)에 같은 헤더를 직접 넣어야 한다. INSTALL.md 참조.
#   - `public/*.html` 에는 `<meta http-equiv="Content-Security-Policy">` 가 없다.
#     즉 .htaccess 가 무시되면 CSP 도 함께 사라진다. v1.0.1 과제.
#   - mod_headers 가 없는 호스팅에서 500 이 나지 않도록 헤더는 전부
#     <IfModule mod_headers.c> 안에 둔다. 없으면 조용히 헤더만 빠진다.
# ---------------------------------------------------------------------

# 디렉토리 목록 노출 방지. index.html 이 있으면 그것을 먼저 준다.
Options -Indexes
DirectoryIndex index.html

# 점(.)으로 시작하는 파일 차단 — 이 파일 자신(.htaccess), .env, .git 부산물.
# Apache 2.4(mod_authz_core) / 2.2 이하 양쪽 문법을 모두 쓴다.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>

  # MIME 스니핑 차단. 사용자 입력이 그대로 저장되는 시스템이므로,
  # 무엇이든 text/plain 으로 나가는 순간 브라우저가 HTML 로 재해석하면 안 된다.
  Header always set X-Content-Type-Options "nosniff"

  # 클릭재킹 차단. 로그인 폼·관리자 콘솔이 남의 페이지 iframe 안에서
  # 열릴 이유가 하나도 없다. CSP frame-ancestors 와 이중으로 건다
  # (구형 브라우저는 frame-ancestors 를 모른다).
  Header always set X-Frame-Options "DENY"

  # 이 프로젝트에서 실질적으로 가장 중요한 헤더다.
  #   reset.html?token={64hex} · verify.html?token={64hex}
  # 로 일회성 토큰이 URL 쿼리로 유통된다. 이 화면에서 외부로 나가는 어떤
  # 요청·이동에도 경로와 쿼리가 실리면 안 된다.
  #
  # 값 선택 이유 — server/.htaccess 는 `no-referrer` 인데 여기는 다르다. 실수가 아니다.
  #   `no-referrer` 를 문서(public/*.html)에 걸면 Fetch 표준에 따라
  #   **same-origin 이면서 GET/HEAD 가 아닌 요청의 Origin 헤더가 `null` 로 바뀐다.**
  #   그러면 core/request.php 의 cors_handle() 이 own_origin() 대조에 실패해
  #   CORS 응답 헤더를 붙이지 않는 경로로 빠진다(CSRF 는 토큰 방식이라 거부되지는
  #   않지만, 헤더 동작이 환경마다 달라지는 회색지대가 생긴다).
  #   `strict-origin-when-cross-origin` 은 교차 출처에는 **출처만** 보내므로
  #   토큰이 실린 경로·쿼리는 나가지 않고, Origin 헤더는 정상으로 남는다.
  #   (SSO 복귀 시 login.html → 외부 앱 이동에서도 출처만 전달된다)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 쓰지 않는 브라우저 기능을 전부 끈다. 이 화면들은 폼과 표뿐이다.
  # 기능명을 브라우저가 모르면 콘솔에 오류가 찍히므로, 널리 인식되는 것만 적는다.
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), usb=()"

  # ---------------------------------------------------------------------
  # Content-Security-Policy
  #
  # ▣ 'unsafe-inline' 이 script-src 에 들어간 이유 (타협이다. 숨기지 않는다)
  #   화면 8개 중 7개가 화면 로직을 **인라인 <script> 블록**으로 갖고 있다
  #   (index.html 만 스크립트가 없다). 빌드 도구가 없는 배포 모델이라
  #   해시(sha256)를 쓰면 HTML 을 한 글자만 고쳐도 해시가 어긋나 전 화면이
  #   조용히 죽는다 — 배포자가 원인을 찾을 수 없는 종류의 고장이다.
  #   nonce 는 정적 파일이라 매 요청 갱신이 불가능하다.
  #   따라서 v1.0.0 은 'unsafe-inline' 을 받아들인다.
  #   v1.0.1 에서 인라인 블록을 assets/*.js 로 빼면 이 토큰을 지울 수 있다.
  #
  #   'unsafe-inline' 이 있어도 이 정책이 여전히 막는 것:
  #     - 외부 도메인 스크립트 로드 (default-src/script-src 'self')
  #     - eval / new Function ('unsafe-eval' 없음 — 코드에 사용처 0건)
  #     - <object>/<embed> 플러그인 (object-src 'none')
  #     - **주입된 코드의 외부 유출 통로** (connect-src 'self')
  #       관리자 콘솔은 공격자가 심은 닉네임·메모를 관리자가 열어보는 화면이다.
  #       XSS 가 성립해도 훔친 데이터를 밖으로 보낼 곳이 없어야 한다.
  #     - <base> 하이재킹 (base-uri 'self')
  #     - iframe 삽입 (frame-ancestors 'none')
  #
  # ▣ style-src 에 'unsafe-inline' 을 넣지 않은 이유
  #   HTML 8개 전부 <style> 블록 0건, style="" 속성 0건 (grep 확인).
  #   JS 의 인라인 스타일은 admin.html 6곳뿐이고 전부 **객체 형태**
  #   (el(tag, { style: { width: '...' } })) 로 ui.js:90 의
  #   `node.style[sk] = ...` CSSOM 대입을 탄다. CSSOM 대입은 CSP 대상이 아니다.
  #   문자열 형태(ui.js:89 `setAttribute('style', ...)`)는 호출처가 0건이다.
  #   → 'unsafe-inline' 없이 동작한다. 실제 브라우저로 8화면 확인했다.
  #   ※ 앞으로 el() 에 style 을 **문자열**로 넘기면 그 지점이 CSP 로 막힌다.
  #     객체 형태를 유지할 것.
  #
  # ▣ form-action 'none'
  #   모든 폼은 submit 을 preventDefault 로 가로채 fetch 로 보낸다.
  #   네이티브 제출은 어디에도 없다. 반대로 api.js 로드가 실패해 JS 가
  #   죽으면 action 없는 로그인 폼이 GET 으로 제출되어
  #   `login.html?username=...&password=...` 가 되고 비밀번호가
  #   **웹서버 액세스 로그와 브라우저 히스토리에 평문으로 남는다.**
  #   'none' 은 그 사고를 막는다.
  #
  # ▣ connect-src 'self' 는 assets/api.js 의 `ULOGIN_API_BASE = '../server'`
  #   (상대 경로 = 동일 출처) 를 전제로 한다.
  #   **API 를 다른 도메인에 두려고 ULOGIN_API_BASE 를 절대 URL 로 바꾸면
  #   그 출처를 connect-src 에 추가해야 한다.** 안 하면 전 화면의 API 호출이
  #   콘솔에 CSP 위반만 남기고 실패한다.
  #
  # ▣ 상위 화면 이동(location.replace)은 CSP 대상이 아니다.
  #   SSO 복귀(login.html → 외부 앱 redirect_to)는 이 정책에 걸리지 않는다.
  # ---------------------------------------------------------------------
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

</IfModule>

# ---------------------------------------------------------------------
# 캐시 정책 (v1.2.0 / 리더 판정 D-85 · D-86)
#
# ▣ 이 블록에 의존하지 마라 — 아래 세 규칙은 전부 mod_headers 안에 있다.
#   모듈이 없거나 AllowOverride None · nginx · LiteSpeed 비호환 모드면
#   **조용히 아무 일도 일어나지 않는다.** 그것이 "새 버전을 올려도 반영이
#   안 된다"는 증상의 근원이었다.
#
#   그래서 배포 반영의 **주 수단은 이 파일이 아니라 자산 URL 의 `?v=` 쿼리다**
#   (public/*.html · examples/*.html 참조 전부에 붙어 있다). 그것은 서버 설정에
#   전혀 의존하지 않는다. 이 블록은 그 위에 얹는 최적화·보강일 뿐이다.
#
#   nginx / AllowOverride None 환경용 동등 설정 스니펫은 INSTALL.md 를 보라.
# ---------------------------------------------------------------------

# 1) HTML 은 캐시하지 않는다.
#   reset.html?token= · verify.html?token= 은 일회성 토큰을 URL 로 받고,
#   mypage/admin 은 로그인 사용자의 데이터를 그린다. 공용 PC 의 디스크 캐시나
#   중간 프록시에 남으면 안 된다.
#   그리고 이것이 `?v=` 방식의 전제다 — HTML 이 항상 새로 받아져야 새 HTML 이
#   가리키는 **새 자산 URL** 이 브라우저에 도달한다.
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
  </IfModule>
</FilesMatch>

# 2) 자산은 오래 캐시한다 — 버전 쿼리가 있으므로 안전하다.
#   assets/*.{css,js} 의 참조 URL 에는 `?v={버전}` 이 붙어 있다. 버전이 바뀌면
#   URL 이 바뀌므로 캐시는 자동으로 무효가 된다. 따라서 immutable 로 못박아도
#   갱신이 막히지 않고, 같은 버전 안에서는 재요청이 사라져 화면이 빨라진다.
#   (public/.htaccess 는 하위 디렉토리에도 상속되므로 assets/ 에 그대로 걸린다)
#
#   ※ 만약 어떤 사정으로 자산 참조에서 `?v=` 를 빼야 한다면 **이 블록도 반드시
#     같이 지워라.** 버전 쿼리 없는 자산에 immutable 을 걸면 1년간 갱신이
#     불가능해져 지금 문제보다 훨씬 나빠진다.
<FilesMatch "\.(css|js)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# 3) version.txt 는 캐시하지 않는다.
#   이 파일의 존재 이유가 "지금 서버에 올라간 버전을 브라우저로 확인하는 것"이다.
#   캐시되면 옛 값을 보여주고, 확인 수단이 거짓말을 하기 시작한다.
<FilesMatch "^version\.txt$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
  </IfModule>
</FilesMatch>
