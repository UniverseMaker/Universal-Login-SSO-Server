# ulogin — .gitignore
# =====================================================================
# 이 저장소는 "설치 루트" 를 그대로 담고 있다. 즉 여기 커밋된 파일이
# 그대로 호스팅에 올라간다. 그래서 이 파일이 막아야 하는 것은
# "빌드 부산물" 이 아니라 **설치 후 서버에 생기는 비밀 파일들**이다.
#
# 실수로 커밋하면 되돌릴 수 없다 — 공개 저장소의 git 이력은 강제 푸시로
# 지워도 포크·캐시·CI 로그에 남는다. 아래 항목을 지우지 마라.
# =====================================================================


# ---------------------------------------------------------------------
# 1. 설정 파일 — DB 비밀번호 · SECRET_ENC_KEY · APP_KEY 가 들어 있다
#
#    install.php 가 설치 시점에 생성한다. 저장소에는 템플릿만 둔다.
#    !! server/config.sample.php 는 반드시 추적해야 한다 !!
#       (아래 패턴은 'config.php' 로 시작하는 이름만 잡으므로
#        'config.sample.php' 는 걸리지 않는다. `git status` 로 확인하라)
# ---------------------------------------------------------------------
server/config.php
server/config.php.*


# ---------------------------------------------------------------------
# 2. 설치기 자기 잠금 파일 (D-52 · D-60)
#
#    이 파일이 저장소에 들어 있으면 **받는 사람이 설치를 시작할 수 없다** —
#    install.php 가 "이미 설치됨" 으로 즉시 종료한다.
#    안에는 설치 시각과 nonce 가 들어 있다.
# ---------------------------------------------------------------------
server/.install.lock
server/storage/.installed


# ---------------------------------------------------------------------
# 3. server/storage/ — 이 파일에서 가장 중요한 항목
#
#    MAIL_DRIVER='log' (기본값) 이면 메일이 발송되지 않고 이 디렉토리에
#    파일로 쌓인다. 그 파일 안에 들어 있는 것:
#      · 비밀번호 재설정 링크 (유효한 토큰 포함)
#      · 이메일 인증 링크 (유효한 토큰 포함)
#      · 관리자가 발급한 임시 비밀번호  ← 전부 평문이다
#    확장자가 `.php` 라서(첫 줄 `<?php exit; ?>`) 브라우저로는 빈 화면이지만
#    **git 에는 텍스트로 그대로 들어간다.** 커밋되면 계정 탈취 수단이 공개된다.
#
#    config.php 를 쓸 수 없는 호스팅에서는 install.php 가
#    storage/config.php.generated.txt 로 **설정 전문(비밀번호·키 포함)** 을
#    떨어뜨린다. 그것도 여기서 함께 막힌다.
#
#    [디렉토리 구조는 유지해야 한다]
#    storage/ 와 storage/mail/ 의 `.htaccess` · `index.html` 은
#    **보안 방어 장치이며 배포물이다**(D-34 / 감사 H-5 다층 방어):
#      · .htaccess   — 웹 접근 차단 (Require all denied)
#      · index.html  — .htaccess 가 무시되는 호스팅에서 디렉토리 목록 차단
#    그래서 `server/storage/` 를 통째로 무시하지 않고 `*` 로 **내용만**
#    무시한 뒤 그 4개를 되살린다. 디렉토리를 통째로 무시하면 git 이 그 안을
#    들여다보지 않으므로 아래 되살리기(!)가 동작하지 않는다.
#    (core/mailer.php 가 없으면 다시 만들지만, 만들어지기 전 첫 요청과
#     쓰기 권한이 없는 호스팅에서는 방어가 비어 있게 된다. 정적으로도 둔다)
# ---------------------------------------------------------------------
server/storage/*
!server/storage/.htaccess
!server/storage/index.html

!server/storage/mail/
server/storage/mail/*
!server/storage/mail/.htaccess
!server/storage/mail/index.html


# ---------------------------------------------------------------------
# 4. OS · 에디터 부산물
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*~
*.bak
*.orig
*.rej


# ---------------------------------------------------------------------
# 5. 로그 · 임시 파일
#
#    이 프로젝트는 자체 로그 파일을 쓰지 않는다(오류는 호스팅의 PHP
#    error_log 로 간다). 그래도 배포 중 손으로 만든 로그가 섞이는 것을 막는다.
# ---------------------------------------------------------------------
*.log
*.tmp
*.pid
.env
.env.*


# ---------------------------------------------------------------------
# 6. 압축 파일
#
#    FTP 업로드용으로 폴더를 압축해 두고 그대로 커밋하는 사고를 막는다.
#    그 안에는 위 1~3의 파일이 전부 들어 있을 수 있다.
# ---------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
