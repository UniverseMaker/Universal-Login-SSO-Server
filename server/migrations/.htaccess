# server/migrations/ 는 웹에서 직접 열 수 없어야 한다.
# 배포 후 브라우저로 /server/migrations/lib.php 를 열어 403/404 인지 확인한다.
# (AllowOverride 가 막혀 있으면 이 파일이 무시된다 — lib.php 자체에도
#  ULOGIN_MIGRATE_CTX 가드가 있어 직접 열면 404 로 죽는다. 겹을 둘로 둔다)

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
