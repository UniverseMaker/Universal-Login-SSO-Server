# core/ 는 웹에서 직접 열 수 없어야 한다.
# 배포 후 브라우저로 /server/core/db.php 를 열어 403 인지 반드시 확인한다.
# (AllowOverride 가 막혀 있으면 이 파일이 무시된다 — 그 경우 server/ 를
#  웹 루트 밖으로 옮기거나 호스팅 관리자에게 문의한다)

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
