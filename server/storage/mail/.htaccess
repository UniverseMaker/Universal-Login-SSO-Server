# 자동 생성 (core/mailer.php). 이 디렉토리는 웹에서 절대 열려서는 안 된다.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
Options -Indexes -ExecCGI
DirectoryIndex index.html
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>
