# ulogin — .gitattributes
# =====================================================================
# 이 저장소는 Windows 에서 만들어졌고, 받는 사람은 대부분 Linux 공용
# 호스팅에 그대로 올린다. 줄바꿈이 CRLF 로 커밋되면 실제로 깨지는 것들:
#   · server/.htaccess 등 6개    — Apache 지시자가 CR 을 값의 일부로 읽는다
#   · server/schema.sql          — 주석·구분자 파싱
#   · public/version.txt         — 배포 확인용 버전 문자열에 CR 이 붙는다
#   · *.php 의 heredoc / 출력    — 응답 헤더 뒤에 CR 이 섞인다
# 그래서 저장소 안의 모든 텍스트를 **LF 로 고정**한다.
# =====================================================================

# 기본 — 텍스트로 판정된 모든 파일을 LF 로 정규화해 커밋·체크아웃한다.
# text=auto 이므로 git 이 바이너리로 판정한 파일은 건드리지 않는다.
* text=auto eol=lf

# ---------------------------------------------------------------------
# 바이너리 — 절대 줄바꿈 변환을 하지 않는다.
# docs/screenshots/ 의 PNG 가 CRLF 변환되면 파일이 깨져 열리지 않는다.
# `binary` 는 `-text -diff` 의 별칭이다.
# ---------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.bmp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary

# ---------------------------------------------------------------------
# 명시적 텍스트 — 확장자가 없거나 git 이 헷갈릴 수 있는 것들.
# ---------------------------------------------------------------------
.gitignore      text eol=lf
.gitattributes  text eol=lf
.htaccess       text eol=lf
LICENSE         text eol=lf
*.md            text eol=lf
*.php           text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.sql           text eol=lf
*.txt           text eol=lf
*.json          text eol=lf

# ---------------------------------------------------------------------
# GitHub 언어 통계 — 문서·스크린샷이 저장소 언어를 가리지 않게 한다.
# (linguist-* 는 GitHub 전용 속성이고 git 동작에는 영향이 없다)
# ---------------------------------------------------------------------
docs/screenshots/*  linguist-documentation
